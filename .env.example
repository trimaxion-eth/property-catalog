# StaySite — local development
# Copy to .env.local and fill in values.

# Required for /api/generate (Phase 1)
# OpenCode Go API key — subscribe at https://opencode.ai/docs/go/
OPENAI_API_KEY=

# Optional — OpenCode Go defaults (OpenAI-compatible SDK)
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_MODEL=deepseek-v4-flash

# App URL for absolute links in dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map tiles (optional — CARTO Voyager + OSM fallback used by default)
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# NEXT_PUBLIC_MAP_FALLBACK_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_FALLBACK_TILE_ATTRIBUTION=

# Phase 2+
# DATABASE_URL=file:./data/staysite.db
